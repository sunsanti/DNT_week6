# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# .env.local is gitignored. Restart `npm run start` after editing (values are inlined at build time).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: use local Firebase emulators instead of the real project.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
